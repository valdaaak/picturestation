# /etc/picturestation/picturestation.env
# Folder with photos (read-only is enough), e.g. an NFS mount of the Synology "photo" share
PICTURESTATION_ROOT=/mnt/photo
# Database, thumbnail cache, GeoNames
PICTURESTATION_DATA=/var/lib/picturestation
PICTURESTATION_TITLE=Picturestation
PICTURESTATION_PORT=80
# Full rescan of the photo tree (seconds), 0 = off
PICTURESTATION_INDEX_INTERVAL=1800
PICTURESTATION_THUMB_WORKERS=2
PICTURESTATION_LOG=INFO
PICTURESTATION_ACCESS_LOG=0
# Places: villages below 500 inhabitants for these countries (full GeoNames dumps, downloaded by install.sh)
#PICTURESTATION_GEONAMES_COUNTRIES=SK,CZ
# Reverse proxies whose X-Forwarded-For is trusted (e.g. the NAS running the DSM reverse proxy)
PICTURESTATION_TRUSTED_PROXIES=127.0.0.1
# Private galleries (Settings > Galleries): their photo folders must be below these folders
#PICTURESTATION_GALLERY_ROOTS=/srv/galleries:/mnt/galleries
# Session cookie name of the main gallery
#PICTURESTATION_COOKIE=PHPSESSID
# Optional: people (face recognition) from Synology Photos, read-only service account with Full Access
#SYNO_URL=https://nas.example.com:5001
#SYNO_USER=picturestation-sync
#SYNO_PASS_FILE=/etc/picturestation/synology.pass
